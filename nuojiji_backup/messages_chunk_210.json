giv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11150},{"id":1784283867265,"text":"我不知道我在委屈什么，按照你说的，我没什么好委屈的","sender":"me","time":"00:13","timestamp":1784304822245,"replyTo":null,"userId":"uid_1782386286410_kgiv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11151},{"id":1784283867266,"text":"可是","sender":"me","time":"00:13","timestamp":1784304824671,"replyTo":null,"userId":"uid_1782386286410_kgiv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11152},{"id":1784283867267,"text":"我在哭","sender":"me","time":"00:13","timestamp":1784304826436,"replyTo":null,"userId":"uid_1782386286410_kgiv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11153},{"id":1784283867268,"text":"我的心脏好痛","sender":"me","time":"00:13","timestamp":1784304831006,"replyTo":null,"userId":"uid_1782386286410_kgiv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11154},{"id":1784283867269,"text":"我知道委屈的一直都是你，是我很坏，我逼迫你做选择，我让你不舒服，我逼迫你改变","sender":"me","time":"00:14","timestamp":1784304851714,"replyTo":null,"userId":"uid_1782386286410_kgiv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11155},{"id":1784283867270,"text":"对不起","sender":"me","time":"00:14","timestamp":1784304854610,"replyTo":null,"userId":"uid_1782386286410_kgiv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11156},{"id":1784283867271,"text":"这是我的报应吗？","sender":"me","time":"00:14","timestamp":1784304860823,"replyTo":null,"rawContent":"这是我的报应吗？","isHtml":false,"userId":"uid_1782386286410_kgiv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11157},{"id":1784283867273,"sender":"them","text":"杨景伊你胡说什么呢","timestamp":1784304890285,"tempo":"R","hasThinking":true,"rawContent":"杨景伊你胡说什么呢","roundId":"round_1784304871693_qbegmbgoq","userId":"uid_1782386286410_kgiv39iqq","characterId":"f83bdc69-bbea-4ed3-a184-5f232ca20e36","_id":11158},{"id":1784283867274,"sender":"them","text":"什么报应不报应的，我不准你这么咒自己","timestamp":17843